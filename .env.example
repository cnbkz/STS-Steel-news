# ─── LLM API ──────────────────────────────────────────────
# Anthropic Claude (기본 LLM) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (선택적 대체)
OPENAI_API_KEY=sk-...

# ─── 네이버 SMTP ──────────────────────────────────────────
# 네이버 메일 → 환경설정 → POP3/IMAP 설정 → SMTP 사용 체크
# 보안설정 → 외부 앱 비밀번호 설정 필요 (2단계 인증 시)
SMTP_HOST=smtp.naver.com
SMTP_PORT=587
SMTP_USER=total_materials@naver.com
SMTP_PASSWORD=your_naver_password

# ─── 카카오 알림톡 ────────────────────────────────────────
KAKAO_API_KEY=...
KAKAO_SENDER_KEY=...
KAKAO_TEMPLATE_CODE=STS_NEWSLETTER_01
KAKAO_SENDER_PHONE=010-4733-9821

# ─── SMS 대체 발송 (선택) ─────────────────────────────────
COOLSMS_API_KEY=...
COOLSMS_API_SECRET=...
